# --- Analysis backend ---
# "ollama" uses a local Ollama model (default, no API key needed)
# "openai" uses OpenAI GPT (requires OPENAI_API_KEY)
ANALYSIS_BACKEND=ollama

# --- Ollama analysis model (used when ANALYSIS_BACKEND=ollama) ---
ANALYSIS_MODEL=qwen3.5:9b

# --- OpenAI (used when ANALYSIS_BACKEND=openai) ---
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini # gpt-4o for higher quality

# --- Ollama screener (triagem local — opcional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Publicação no data lake do DataHandler (opcional) ---
# Raiz do lake que o Google Drive sincroniza — a MESMA pasta que DATA_DIR aponta
# no DataHandler. Ao final de cada execução, a base de notícias é exportada para
# <DATAHANDLER_DATA_DIR>/news/clipping/articles.parquet.
# Deixe em branco para usar o caminho padrão; se a pasta não existir, o sync é
# silenciosamente ignorado e o briefing segue normalmente.
DATAHANDLER_DATA_DIR=G:\My Drive\4. Trabalho\Safra_CG_db\data
# Quando o G: não está montado (task agendada rodando sem usuário logado), o
# sync sobe os arquivos via rclone pela API do Drive para este remote — a MESMA
# pasta acima vista pelo rclone. Setup único: `winget install Rclone.Rclone` +
# `rclone config create gdrive drive scope=drive`. Deixe vazio para desligar.
DATAHANDLER_REMOTE=gdrive:4. Trabalho/Safra_CG_db/data
# RCLONE_EXE=C:\caminho\para\rclone.exe   # opcional, se não estiver no PATH/winget

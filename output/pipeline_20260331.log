22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: article None
22:18:14 [DEBUG] trafilatura.main_extractor: discarding element: div None

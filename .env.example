# --- Analysis backend ---
# "ollama" uses a local Ollama model (default, no API key needed)
# "openai" uses OpenAI GPT (requires OPENAI_API_KEY)
ANALYSIS_BACKEND=ollama

# --- Ollama analysis model (used when ANALYSIS_BACKEND=ollama) ---
ANALYSIS_MODEL=qwen3.5:9b

# --- OpenAI (used when ANALYSIS_BACKEND=openai) ---
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini # gpt-4o for higher quality

# --- Ollama screener (triagem local — opcional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

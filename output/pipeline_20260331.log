22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: section None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
22:30:09 [DEBUG] trafilatura.main_extractor: discarding element: div None
